@echo off
chcp 65001 > nul
title Запуск учебного портала: Академия МВД РК

:: Переход в директорию, где лежит данный файл
cd /d "%~dp0"

echo ===================================================================
echo   Учебный портал: Академия МВД Республики Казахстан
echo   "Современные информационные угрозы и методы противодействия"
echo ===================================================================
echo   Рабочая папка: %CD%
echo ===================================================================
echo.

:: 1. Проверка наличия Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [ОШИБКА] Node.js не найден в системе!
    echo.
    echo РЕШЕНИЕ:
    echo 1. Если вы установили Node.js 1 минуту назад — ОБЯЗАТЕЛЬНО
    echo    ПЕРЕЗАГРУЗИТЕ ВАШ КОМПЬЮТЕР!
    echo    Пока вы не перезагрузите ПК, Windows не активирует Node.js.
    echo 2. Если еще не скачивали, скачайте бесплатный Node.js LTS:
    echo    https://nodejs.org/
    echo.
    echo Нажмите любую клавишу для выхода...
    pause > nul
    exit /b 1
)

echo [OK] Node.js обнаружен:
call node -v
echo.

:: 2. Проверка package.json
if not exist "package.json" (
    echo [ОШИБКА] Файл package.json не найден в папке %CD%!
    echo.
    echo Возможно, архив был не полностью распакован.
    echo Пожалуйста, извлеките все файлы из ZIP-архива в обычную папку.
    echo.
    pause
    exit /b 1
)

:: 3. Первичная установка зависимостей
if not exist "node_modules\" (
    echo [ШАГ 1 ИЗ 2] Первичная установка библиотек (npm install)...
    echo Это займет около 1-2 минут, пожалуйста, подождите...
    echo.
    call npm install
    if %errorlevel% neq 0 (
        echo.
        echo [ОШИБКА] npm install завершился с ошибкой.
        echo Проверьте подключение к интернету.
        pause
        exit /b 1
    )
    echo [OK] Библиотеки успешно установлены!
    echo.
)

:: 4. Запуск локального сервера Vite
echo [ШАГ 2 ИЗ 2] Запуск сервера (npm run dev)...
echo.
echo Сейчас в вашем браузере откроется: http://localhost:3000
echo НЕ ЗАКРЫВАЙТЕ это окно, пока пользуетесь презентацией!
echo.
echo ===================================================================
echo.

:: Небольшая пауза перед открытием браузера
timeout /t 2 /nobreak > nul
start http://localhost:3000
call npm run dev

if %errorlevel% neq 0 (
    echo.
    echo [ОШИБКА ПРИ ЗАПУСКЕ]
    echo Попробуйте альтернативный запуск собранной версии dist:
    if exist "dist\index.html" (
        echo Запускаем встроенный просмотр dist...
        call npx serve dist
    )
    pause
)
